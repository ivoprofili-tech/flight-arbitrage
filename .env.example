# Proxy Configuration for Geo Arbitrage
# Copy this file to .env and fill in your credentials
#
# Supported providers:
#   - webunlocker    : BrightData Web Unlocker (RECOMMENDED for Google)
#   - brightdata     : BrightData Residential (blocked by Google without KYC)
#   - oxylabs        : Oxylabs Residential
#   - smartproxy     : Smartproxy Residential

# Provider name (required for geo arbitrage)
# Use "webunlocker" for Google Flights (handles anti-bot protection)
PROXY_PROVIDER=webunlocker

# Your proxy credentials
PROXY_USERNAME=your-username-here
PROXY_PASSWORD=your-password-here

# Optional: Custom host/port (usually not needed)
# PROXY_HOST=brd.superproxy.io
# PROXY_PORT=33335
