# =============================================================================
# SerpApi Configuration (REQUIRED for Google Flights)
# =============================================================================
# Get your free API key at: https://serpapi.com/manage-api-key
# Free tier: 250 searches/month (enough for ~8 geo-arbitrage runs/day)
SERPAPI_KEY=your-serpapi-key-here

# =============================================================================
# Proxy Configuration (OPTIONAL - only needed for Skiplagged geo-targeting)
# =============================================================================
# Google Flights no longer needs proxies -- SerpApi handles geo-targeting
# via the gl parameter. Proxies are only needed if you want to run
# Skiplagged searches from different geographic locations.
#
# Supported providers:
#   - webunlocker    : BrightData Web Unlocker
#   - brightdata     : BrightData Residential
#   - oxylabs        : Oxylabs Residential
#   - smartproxy     : Smartproxy Residential

# Provider name (only needed for Skiplagged geo-targeting)
# PROXY_PROVIDER=webunlocker

# Your proxy credentials
# PROXY_USERNAME=your-username-here
# PROXY_PASSWORD=your-password-here

# Optional: Custom host/port (usually not needed)
# PROXY_HOST=brd.superproxy.io
# PROXY_PORT=33335
